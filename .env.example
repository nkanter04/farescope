# Copy to apps/api/.env and fill in. Never commit the real .env.

# Data provider: "mock" (free, fake prices), "serpapi" (real Google Flights / Hotels data) or
# "travelpayouts" (cached real fares from Aviasales; free for Travelpayouts affiliates)
PROVIDER=mock
SERPAPI_KEY=
# Travelpayouts: API token and your affiliate marker, both from the Travelpayouts dashboard.
# The token is secret (server only). With PROVIDER=travelpayouts, hotel prices come from SerpApi
# if SERPAPI_KEY is set; otherwise lodging shows booking links only.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Web build (public, not secret): partner/affiliate link templates, "Name|kind|https://…" separated
# by ";;". kinds: flight, stay, hostel, activity, car. Placeholders: {origin} {destination} {depart}
# {return} {departDDMM} {returnDDMM} {checkIn} {checkOut} {adults} {city} {country}.
# Set this as a GitHub Actions variable (VITE_PARTNER_LINKS) for the deployed site.
VITE_PARTNER_LINKS=

# Hard cap on real provider calls per calendar month (free SerpApi tier is ~100-250)
MONTHLY_QUERY_BUDGET=100
# Per-client daily cap on real provider calls
DAILY_CLIENT_BUDGET=10
# Max real calls a single flexible search may spend (rest is sampled / served from cache)
PER_SEARCH_BUDGET=6

PORT=8787
# Where the SQLite cache / price history lives
DATA_DIR=.local-data

# Phase 2/4: accounts and hosted DB
SUPABASE_URL=
SUPABASE_ANON_KEY=
