# Copy to apps/api/.env and fill in. Never commit the real .env.

# Data provider: "mock" (free, fake prices), "serpapi" (real Google Flights / Hotels data) or
# "travelpayouts" (cached real fares from Aviasales; free for Travelpayouts affiliates)
PROVIDER=mock
SERPAPI_KEY=
# Travelpayouts: API token and your affiliate marker, both from the Travelpayouts dashboard.
# The token is secret (server only). With PROVIDER=travelpayouts, hotel prices come from SerpApi
# if SERPAPI_KEY is set; otherwise lodging shows booking links only.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Web build (public, not secret): partner/affiliate link templates, "Name|kind|https://…" separated
# by ";;". kinds: flight, stay, hostel, activity, car. Placeholders: {origin} {destination} {depart}
# {return} {departDDMM} {returnDDMM} {checkIn} {checkOut} {adults} {city} {country}.
# Set this as a GitHub Actions variable (VITE_PARTNER_LINKS) for the deployed site.
VITE_PARTNER_LINKS=

# Hard cap on real provider calls per calendar month (free SerpApi tier is ~100-250)
MONTHLY_QUERY_BUDGET=100
# Per-client daily cap on real provider calls
DAILY_CLIENT_BUDGET=10
# Max real calls a single flexible search may spend (rest is sampled / served from cache)
PER_SEARCH_BUDGET=6

PORT=8787
# Where the SQLite cache / price history lives
DATA_DIR=.local-data

# Bot check for live searches (Cloudflare Turnstile, free). The secret is server-only
# (`npx wrangler secret put TURNSTILE_SECRET_KEY` on Cloudflare); the site key is public and goes
# in the web build (GitHub Actions variable VITE_TURNSTILE_SITE_KEY). Leave empty locally.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Accounts (Clerk). Leave empty to run without accounts. The secret key is server-only
# (`npx wrangler secret put CLERK_SECRET_KEY` on Cloudflare); the publishable key is public and goes
# in the web build (GitHub Actions variable VITE_CLERK_PUBLISHABLE_KEY).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: site origins allowed to use sign-in tokens (comma-separated), e.g. https://tripica.farescope.workers.dev
CLERK_AUTHORIZED_PARTIES=
# Live lookups per signed-in account per month (visitors get DAILY_CLIENT_BUDGET per day)
ACCOUNT_MONTHLY_BUDGET=50

# Tripica Pro (Stripe). Billing turns on when all four are set; needs accounts (Clerk). Use test-mode
# keys (sk_test_...) locally. `npx tsx scripts/stripe-setup.ts` creates the product and prices and
# writes the price IDs here. On Cloudflare: `npx wrangler secret put STRIPE_SECRET_KEY` (and the webhook secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Customer portal (manage/cancel page) settings, created by the setup script
STRIPE_PORTAL_CONFIG=
# Let Stripe Tax compute sales tax (turn on Stripe Tax first)
STRIPE_AUTOMATIC_TAX=false
# Live lookups per month for Pro, and during the free trial
PRO_MONTHLY_BUDGET=500
TRIAL_BUDGET=100
TRIAL_DAYS=3

# Phase 2/4: accounts and hosted DB
SUPABASE_URL=
SUPABASE_ANON_KEY=
