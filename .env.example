# Copy to apps/api/.env and fill in. Never commit the real .env.

# Data provider: "mock" (free, fake prices) or "serpapi" (real Google Flights / Hotels data)
PROVIDER=mock
SERPAPI_KEY=

# Hard cap on real provider calls per calendar month (free SerpApi tier is ~100-250)
MONTHLY_QUERY_BUDGET=100
# Per-client daily cap on real provider calls
DAILY_CLIENT_BUDGET=10
# Max real calls a single flexible search may spend (rest is sampled / served from cache)
PER_SEARCH_BUDGET=6

PORT=8787
# Where the SQLite cache / price history lives
DATA_DIR=.local-data

# Phase 2/4: accounts and hosted DB
SUPABASE_URL=
SUPABASE_ANON_KEY=
