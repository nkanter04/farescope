{
  "name": "farescope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @farescope/api",
    "dev:web": "npm run dev -w @farescope/web",
    "build": "npm run build -w @farescope/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "backtest": "tsx scripts/backtest-forecast.ts",
    "guides:fetch": "tsx scripts/guides-fetch.ts",
    "guides:build": "tsx apps/web/src/guides/build.tsx"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
